{
  "name": "fanda-app",
  "version": "1.0.0",
  "description": "饭搭 - 情侣和饭搭子点菜小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:tt": "taro build --type tt",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "test": "jest"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/preset-react": "^7.29.7",
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.0",
    "babel-preset-taro": "4.2.1",
    "eslint": "^8.41.0",
    "eslint-config-taro": "4.2.1",
    "postcss": "^8.4.35",
    "react-refresh": "^0.14.0",
    "sass": "^1.71.0",
    "typescript": "^5.4.0",
    "webpack": "5.91.0"
  }
}
