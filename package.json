{
  "name": "fanda-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "饭搭项目根目录启动入口",
  "scripts": {
    "postinstall": "node scripts/install-deps.js --skip-heavy",
    "bootstrap": "node scripts/install-deps.js",
    "setup:registry": "node scripts/setup-npm-registry.js",
    "generate:api": "node scripts/generate-openapi.js",
    "start": "node scripts/start.js",
    "test": "node --test scripts/*.test.js",
    "dev:h5": "npm --prefix fanda-app run dev:h5",
    "build:h5": "npm --prefix fanda-app run build:h5",
    "dev:server": "go -C fanda-server run cmd/server/main.go",
    "db:start": "node scripts/start.js postgres",
    "db:migrate": "go -C fanda-server run cmd/migrate/main.go",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.12"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
