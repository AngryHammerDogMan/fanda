# 文件职责：服务端本地启动配置模板；复制为 .env 后按环境覆盖真实值。

# 服务器配置：端口影响 Gin 监听地址，模式影响日志级别和生产安全校验。
SERVER_PORT=8080
SERVER_MODE=debug

# PostgreSQL 数据库：业务主库连接信息，迁移命令和 API 服务共用。
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=fanda
DB_SSLMODE=disable

# Redis：可选缓存依赖，连接失败时服务仍可运行但缓存能力不可用。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 密钥：用于签发用户登录态；生产环境必须改为高强度随机值。
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRE_HOURS=168

# 后台管理：/admin 接口的简单口令，生产环境必须替换默认值。
ADMIN_PASSWORD=change-this-admin-password

# CORS，开发可用 *，生产建议填写正式域名，多个域名用英文逗号分隔
CORS_ALLOW_ORIGINS=*

# 微信小程序（SERVER_MODE=release 必填真实值，用于 jscode2session）
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# 抖音小程序（SERVER_MODE=release 必填真实值，用于 code2session）
DY_APPID=your_dy_appid
DY_SECRET=your_dy_secret

# 文件上传：UPLOAD_DIR 是保存目录，MAX_UPLOAD_SIZE 单位为字节。
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
